# Токен бота от BotFather. Обязателен.
TELEGRAM_BOT_TOKEN=

# Telegram user id владельца, можно несколько через запятую. Обязателен.
ALLOWED_USER_IDS=

# Адрес локального сервиса OpenCode.
OPENCODE_URL=http://127.0.0.1:49374

# Путь к файлу, из которого берется пароль basic auth (по умолчанию).
OPENCODE_SERVICE_JSON=/home/user/.config/opencode/service.json

# Переопределить пароль basic auth (необязательно).
# OPENCODE_PASSWORD=

# Путь к исполняемому файлу opencode.
OPENCODE_BIN=/home/user/.local/bin/opencode

# База бота.
OCBOT_DB_PATH=/home/user/.local/share/opencode-telegram-bot/bot.db

# INFO или DEBUG.
OCBOT_LOG_LEVEL=INFO

# Через сколько минут напоминать о нерешенном запросе прав.
PERMISSION_REMINDER_MINUTES=5

# Как часто обновлять сообщение прогресса, секунды.
PROGRESS_EDIT_SECONDS=2.0

# Голосовая диктовка: модель, язык и каталог на диске /srv.
STT_MODEL=small
STT_LANGUAGE=ru
STT_COMPUTE_TYPE=int8
STT_MODEL_DIR=/opt/opencode-telegram-bot/.models
STT_MAX_SECONDS=300
